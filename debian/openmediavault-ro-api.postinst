#!/usr/bin/env dash
set -e

. /etc/default/openmediavault
. /usr/share/openmediavault/scripts/helper-functions

case "$1" in
	configure)
		echo "Updating configuration database ..."
		omv-confdbadm create "conf.service.roapi"
		if [ -n "$2" ]; then
			omv-confdbadm migrate "conf.service.roapi" "${2}" || :
		fi

		LOG_FILE="/var/log/openmediavault-ro-api.log"
		if [ ! -f "${LOG_FILE}" ]; then
			touch "${LOG_FILE}"
		fi
		chmod 0640 "${LOG_FILE}" || :
		chown root:adm "${LOG_FILE}" 2>/dev/null || :
		printf "%s INFO [lifecycle] 127.0.0.1 openmediavault-ro-api package configured and ready\n" "$(date -Iseconds)" >> "${LOG_FILE}" || :

		# Auto-detect the active OMV WebGUI PHP-FPM socket (PHP 8.2 on OMV 7, PHP 8.4 on OMV 8)
		NGINX_CONF="/etc/nginx/openmediavault-webgui.d/openmediavault-ro-api.conf"
		if [ -f "${NGINX_CONF}" ]; then
			FPM_SOCK=""
			if [ -f /etc/nginx/sites-available/openmediavault-webgui ]; then
				FPM_SOCK=$(sed -n 's/.*fastcgi_pass[[:space:]]\+unix:\([^;]*openmediavault-webgui\.sock\);.*/\1/p' /etc/nginx/sites-available/openmediavault-webgui | head -n 1)
			fi
			if [ -z "${FPM_SOCK}" ]; then
				for candidate in /run/php/php*-fpm-openmediavault-webgui.sock; do
					if [ -S "${candidate}" ]; then
						FPM_SOCK="${candidate}"
						break
					fi
				done
			fi
			if [ -n "${FPM_SOCK}" ]; then
				sed -i "s|unix:/run/php/php[^;]*-fpm-openmediavault-webgui\.sock|unix:${FPM_SOCK}|g" "${NGINX_CONF}" || :
			fi
		fi

		if command -v nginx >/dev/null 2>&1 && nginx -t >/dev/null 2>&1; then
			systemctl reload nginx 2>/dev/null || service nginx reload 2>/dev/null || :
		fi

		dpkg-trigger update-fixperms || :
		dpkg-trigger update-workbench || :
		dpkg-trigger restart-engined || :
	;;

	abort-upgrade|abort-remove|abort-deconfigure)
	;;

	*)
		echo "postinst called with unknown argument '$1'" >&2
		exit 1
	;;
esac

#DEBHELPER#

exit 0
