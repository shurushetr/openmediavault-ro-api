#!/usr/bin/env dash
set -e

. /etc/default/openmediavault
. /usr/share/openmediavault/scripts/helper-functions

case "$1" in
	configure)
		echo "Updating configuration database ..."
		omv-confdbadm create "conf.service.roapi"
		if [ -n "$2" ]; then
			omv-confdbadm migrate "conf.service.roapi" "${2}" || :
		fi

		LOG_FILE="/var/log/openmediavault-ro-api.log"
		if [ ! -f "${LOG_FILE}" ]; then
			touch "${LOG_FILE}"
		fi
		chmod 0640 "${LOG_FILE}" || :
		chown root:adm "${LOG_FILE}" 2>/dev/null || :
		printf "%s INFO [lifecycle] 127.0.0.1 openmediavault-ro-api package configured and ready\n" "$(date -Iseconds)" >> "${LOG_FILE}" || :

		dpkg-trigger update-workbench || :
		dpkg-trigger restart-engined || :

		if command -v omv-mkworkbench >/dev/null 2>&1; then
			omv-mkworkbench all || :
		fi
	;;

	abort-upgrade|abort-remove|abort-deconfigure)
	;;

	*)
		echo "postinst called with unknown argument '$1'" >&2
		exit 1
	;;
esac

#DEBHELPER#

exit 0
