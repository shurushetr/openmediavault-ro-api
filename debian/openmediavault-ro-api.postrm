#!/usr/bin/env dash
set -e

. /etc/default/openmediavault
. /usr/share/openmediavault/scripts/helper-functions

remove_action() {
	rm -f /run/openmediavault-ro-api.cache /run/openmediavault-ro-api.status.json
	rm -f /etc/nginx/openmediavault-webgui.d/openmediavault-ro-api.conf
	if command -v nginx >/dev/null 2>&1 && nginx -t >/dev/null 2>&1; then
		systemctl reload nginx 2>/dev/null || service nginx reload 2>/dev/null || :
	fi
	dpkg-trigger update-workbench || :
	dpkg-trigger restart-engined || :
}

case "$1" in
	purge|remove)
		# Intentionally preserve /config/services/roapi in /etc/openmediavault/config.xml
		# so uninstalling or upgrading never deletes user settings or modifies config.xml destructively.
		remove_action
	;;

	upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
	;;

	*)
		echo "postrm called with unknown argument '$1'" >&2
		exit 1
	;;
esac

#DEBHELPER#

exit 0
